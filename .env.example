# ===== 数据库（必填，生产环境）=====
# 本地开发不需要配：默认用本地文件 SQLite（file:./makerhub.db）
# 生产（Vercel 等 serverless）必须用托管数据库。推荐 Turso 免费版：
# 1. 打开 https://turso.tech 用 GitHub 登录
# 2. 创建数据库：turso db create makerhub
# 3. 获取连接信息：turso db show makerhub 和 turso db tokens create makerhub
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== LLM 增强解析（可选）=====
# 配了之后，BOM 解析会用 LLM 更聪明地识别零件；不配则用内置规则解析（够用）
# 兼容 OpenAI 格式，默认走 DeepSeek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 设为 true 则 BOM 解析始终走 LLM（默认只在发布页勾选时用）
# LLM_ALWAYS=false
